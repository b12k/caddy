{
  "name": "@b12k/caddy",
  "version": "2.11.9-v.0",
  "description": "The missing NPM wrapper for Caddy",
  "keywords": [
    "automatic-https",
    "caddy",
    "cli",
    "development",
    "http",
    "https",
    "npm",
    "reverse-proxy",
    "server",
    "static-files",
    "web-server",
    "wrapper"
  ],
  "license": "MIT",
  "author": "Bogdan Kolesnyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b12k/caddy.git"
  },
  "bin": {
    "caddy": "dist/cli.js",
    "caddy-install": "dist/postinstall.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "check": "run-p -l check:*",
    "check:format": "oxfmt . --check",
    "check:scripts": "oxlint",
    "check:types": "tsc --noEmit",
    "deps:check": "ncu -e 2 -c 1",
    "deps:update": "ncu -du --doctorInstall \"pnpm deps:update:install\" --doctorTest \"pnpm deps:update:doctor\" -c 1",
    "deps:update:doctor": "run-p -l check:types check:scripts build",
    "deps:update:install": "pnpm i --no-frozen-lockfile",
    "dev": "rslib --watch",
    "fix": "run-s -l fix:*",
    "fix:format": "oxfmt . --write",
    "fix:scripts": "oxlint --fix",
    "ga:notify": "tsx .github/notify.ts",
    "ga:update-caddy": "tsx .github/update-caddy.ts",
    "husky:commit-msg": "commitlint",
    "husky:pre-commit": "lint-staged",
    "husky:pre-push": "branch-name-lint",
    "postinstall": "node scripts/postinstall.js",
    "prepack": "run-p check build",
    "prepare": "husky",
    "release": "release-it --preRelease=v"
  },
  "dependencies": {
    "boxen": "9.0.0",
    "pnpm": "12.16.1",
    "tar": "7.5.22",
    "update-notifier": "7.3.1"
  },
  "devDependencies": {
    "@b12k/branch-name-lint": "1.3.0",
    "@commitlint/config-conventional": "21.2.4",
    "@release-it/conventional-changelog": "12.0.2",
    "@rslib/core": "1.0.5",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "@types/update-notifier": "6.0.9",
    "commitlint": "21.2.4",
    "eslint-plugin-perfectionist": "5.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-check-updates": "23.1.1",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "release-it": "21.1.2",
    "semver": "7.8.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
